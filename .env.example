# Copy to .env and fill in real values. Never commit .env.

DATA_DIR=data
LOG_LEVEL=INFO

# Raw data store (ADR-0003); defaults to the public dataset. HF_TOKEN is only for mirroring.
RAW_STORE=hf://datasets/nomi-bdbi-gt/nomi-raw-data
HF_TOKEN=

# Cloudflare R2, reserved for publishing the app dataset (NOMI-038)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
