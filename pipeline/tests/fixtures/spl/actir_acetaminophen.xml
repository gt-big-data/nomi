               <code code="55106-9" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - ACTIVE INGREDIENT SECTION"/>
               <title mediaType="text/x-hl7-title+xml">Drug Facts</title>
               <text>
                  <paragraph>
                     <content styleCode="bold">Active ingredient (in each tablet)</content>
                  </paragraph>
                  <paragraph>Acetaminophen .............................. 325 mg</paragraph>
